header.header
  .container-fluid
    .row.align-items-center
      //- Bên trái: Logo hoặc Tên trang (Khớp với độ rộng sidebar khi thu nhỏ)
      .col-6.d-flex.align-items-center
        .inner-logo
          a(href=`${prefixAdmin}/dashboard`) 
            span.brand-text ADMIN
            span.brand-dot .

      //- Bên phải: User Menu
      .col-6.text-right
        .user-dropdown.dropdown
          button#userMenuButton.btn.dropdown-toggle(
            type="button"
            data-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          )
            .user-info.d-none.d-md-flex
              span.user-name Chào mừng, #{user.fullName} !
            img.user-avatar(
              src=user.avatar ? user.avatar : "/admin/images/avatar.png"
              alt=user.fullName
            )